             to store rollout videos
     """
+    # A deterministic run directory is useful for managed, archived runs. This
+    # only changes output placement; the original timestamped behavior remains
+    # the default when ROBOCASA_RUN_DIR is unset.
+    managed_run_dir = os.environ.get("ROBOCASA_RUN_DIR")
+    if managed_run_dir:
+        base_output_dir = os.path.abspath(os.path.expanduser(managed_run_dir))
+        managed_artifacts = [
+            os.path.join(base_output_dir, name)
+            for name in ("models", "logs", "videos", "vis", "config.json")
+        ]
+        if any(os.path.exists(path) for path in managed_artifacts):
+            raise RuntimeError(
+                "managed run directory already contains training artifacts: "
+                + base_output_dir
+            )
+        os.makedirs(base_output_dir, exist_ok=True)
+
+        output_dir = None
+        if config.experiment.save.enabled:
+            output_dir = os.path.join(base_output_dir, "models")
+            os.makedirs(output_dir)
+        log_dir = os.path.join(base_output_dir, "logs")
+        video_dir = os.path.join(base_output_dir, "videos")
+        vis_dir = os.path.join(base_output_dir, "vis")
+        os.makedirs(log_dir)
+        os.makedirs(video_dir)
+        os.makedirs(vis_dir)
+        return log_dir, output_dir, video_dir, vis_dir
+
     # timestamp for directory names
