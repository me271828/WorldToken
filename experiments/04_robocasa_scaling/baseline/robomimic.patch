+class LegacyEMAModel:
+    """
+    Compatibility implementation of the model-based EMAModel API used by
+    diffusers 0.11.1. Newer diffusers releases expose parameter shadows
+    instead of ``averaged_model``.
+    """
+
+    def __init__(self, model, power=2.0 / 3.0, max_decay=0.9999):
+        self.averaged_model = deepcopy(model).eval()
+        self.averaged_model.requires_grad_(False)
+        self.power = power
+        self.max_decay = max_decay
+        self.optimization_step = 0
+
+    def get_decay(self, optimization_step):
+        epoch = max(0, optimization_step - 1)
+        value = 1 - (1 + epoch) ** (-self.power)
+        return min(value, self.max_decay)
+
+    @torch.no_grad()
+    def step(self, model):
+        self.optimization_step += 1
+        decay = self.get_decay(self.optimization_step)
+        one_minus_decay = 1 - decay
+        for averaged_param, param in zip(
+            self.averaged_model.parameters(),
+            model.parameters(),
+        ):
+            averaged_param.sub_(one_minus_decay * (averaged_param - param))
+
